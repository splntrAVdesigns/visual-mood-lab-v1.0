{
  "name": "visual-mood-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify:seed": "tsx --env-file=.env.local scripts/verify-seed.ts",
    "verify:control-surface": "tsx scripts/verify-control-surface.ts",
    "verify:midi-runtime": "tsx scripts/verify-midi-runtime.ts",
    "verify:security": "tsx scripts/verify-security-guards.ts",
    "verify:render-pool": "tsx scripts/verify-render-pool.ts",
    "verify:tile-state": "tsx scripts/verify-tile-state.ts",
    "verify:persist": "tsx scripts/verify-persist.ts",
    "verify:sandbox": "tsx scripts/verify-sandbox-messages.ts",
    "verify:headers": "tsx scripts/verify-headers.ts",
    "verify:roll": "tsx scripts/verify-roll.ts",
    "verify:roll-store": "tsx scripts/verify-roll-store.ts",
    "verify:schema-fuzz": "tsx scripts/verify-schema-fuzz.ts",
    "verify:site-url": "tsx scripts/verify-site-url.ts",
    "verify:soak": "tsx scripts/verify-soak.ts",
    "soak": "tsx scripts/soak.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:fresh": "tsx --env-file=.env.local scripts/seed.ts -- --fresh",
    "db:generate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:push": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit push",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "backfill:posters": "tsx --env-file=.env.local scripts/backfill-posters.ts",
    "verify:panel-layout": "tsx scripts/verify-panel-layout.ts",
    "verify:backdrop-dismiss": "tsx scripts/verify-backdrop-dismiss.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.6.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "mediabunny": "^1.55.3",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "p5": "^1.11.13",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.1.11",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.62.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "esbuild": "0.19.12",
    "tsx": {
      "esbuild": "0.19.12"
    }
  }
}
