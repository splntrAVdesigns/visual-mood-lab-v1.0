{
  "version": 1,
  "effects": [
    {
      "id": "dark-strobe",
      "title": "Dark Strobe",
      "family": "strobe",
      "file": "dark-strobe.frag",
      "hint": "Black-flicker strobe, driven by rate and duty cycle. The only Beta-tier effect that's temporal rather than spatial — see IMPLEMENTATION_PLAN.md \u00a77 Phase 4.96 for why it shipped first in Part 1.",
      "params": [
        {
          "id": "rate",
          "kind": "slider",
          "label": "Rate",
          "group": "params",
          "default": 8,
          "min": 0.5,
          "max": 30,
          "step": 0.1,
          "unit": "Hz",
          "order": 0,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_strobeRate", "glslType": "float" }
        },
        {
          "id": "duty",
          "kind": "slider",
          "label": "Duty cycle",
          "group": "params",
          "hint": "Fraction of each cycle held black. Higher = more black, less visible frame.",
          "default": 0.5,
          "min": 0.05,
          "max": 0.95,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_strobeDuty", "glslType": "float" }
        },
        {
          "id": "hardness",
          "kind": "slider",
          "label": "Edge hardness",
          "group": "params",
          "hint": "0 = smooth crossfade between lit and black. 1 = a hard on/off cut.",
          "default": 1,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 2,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_strobeHardness", "glslType": "float" }
        },
        {
          "id": "echo",
          "kind": "slider",
          "label": "Echo",
          "group": "params",
          "hint": "Fading trail of recent frames, ghosting through the strobe's dark gaps. 0 disables it entirely — no extra cost when off.",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 3,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_echoAmount", "glslType": "float" }
        }
      ]
    },
    {
      "id": "linear-mirror",
      "title": "Linear Mirror",
      "family": "mirror",
      "file": "linear-mirror.frag",
      "hint": "Folds the frame across a line at an adjustable angle and offset.",
      "params": [
        {
          "id": "angle",
          "kind": "slider",
          "label": "Angle",
          "group": "params",
          "hint": "Orientation of the mirror line, in degrees.",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "order": 0,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_angle", "glslType": "float" }
        },
        {
          "id": "offset",
          "kind": "slider",
          "label": "Offset",
          "group": "params",
          "hint": "Moves the mirror line off-center. 0 folds through the middle of the frame.",
          "default": 0,
          "min": -0.5,
          "max": 0.5,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_offset", "glslType": "float" }
        }
      ]
    },
    {
      "id": "quad-mirror",
      "title": "Quad Mirror",
      "family": "mirror",
      "file": "quad-mirror.frag",
      "hint": "Folds all four quadrants around an adjustable center point into one — the classic 4-way mirror.",
      "params": [
        {
          "id": "centerX",
          "kind": "slider",
          "label": "Center X",
          "group": "params",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 0,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_centerX", "glslType": "float" }
        },
        {
          "id": "centerY",
          "kind": "slider",
          "label": "Center Y",
          "group": "params",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_centerY", "glslType": "float" }
        }
      ]
    },
    {
      "id": "invert",
      "title": "Invert",
      "family": "mirror",
      "file": "invert.frag",
      "hint": "Point reflection through an adjustable center — completes the Linear/Quad/Invert mirror family.",
      "params": [
        {
          "id": "centerX",
          "kind": "slider",
          "label": "Center X",
          "group": "params",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 0,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_centerX", "glslType": "float" }
        },
        {
          "id": "centerY",
          "kind": "slider",
          "label": "Center Y",
          "group": "params",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_centerY", "glslType": "float" }
        }
      ]
    },
    {
      "id": "math-warp",
      "title": "Math Warp",
      "family": "warp",
      "file": "math-warp.frag",
      "hint": "Parametric domain warps — Quadratic is the T(x,y) = [x+y, x²−y²] transform; Swirl a vortex fold. More formulas can be added later without growing this list.",
      "params": [
        {
          "id": "mode",
          "kind": "select",
          "label": "Formula",
          "group": "params",
          "default": "0",
          "valueType": "number",
          "options": [
            { "value": "0", "label": "Quadratic" },
            { "value": "1", "label": "Swirl" }
          ],
          "order": 0,
          "binding": { "target": "uniform", "name": "u_warpMode", "glslType": "float" }
        },
        {
          "id": "amount",
          "kind": "slider",
          "label": "Amount",
          "group": "params",
          "hint": "Blend between the untouched frame and the fully-warped result.",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_amount", "glslType": "float" }
        },
        {
          "id": "scale",
          "kind": "slider",
          "label": "Scale",
          "group": "params",
          "hint": "Zoom of the warp field — smaller values pull the formula's detail wider across the frame.",
          "default": 1.5,
          "min": 0.2,
          "max": 4,
          "step": 0.01,
          "order": 2,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_scale", "glslType": "float" }
        }
      ]
    },
    {
      "id": "hue-shift",
      "title": "Hue Shift LUT",
      "family": "color",
      "file": "hue-shift.frag",
      "hint": "HSV hue/saturation/brightness grade. Shader-based, not a texture LUT yet — see the shader's own doc for the scoping note.",
      "params": [
        {
          "id": "hue",
          "kind": "slider",
          "label": "Hue",
          "group": "params",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "order": 0,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_hue", "glslType": "float" }
        },
        {
          "id": "saturation",
          "kind": "slider",
          "label": "Saturation",
          "group": "params",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.01,
          "order": 1,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_saturation", "glslType": "float" }
        },
        {
          "id": "brightness",
          "kind": "slider",
          "label": "Brightness",
          "group": "params",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.01,
          "order": 2,
          "modulatable": true,
          "binding": { "target": "uniform", "name": "u_brightness", "glslType": "float" }
        }
      ]
    }
  ]
}
